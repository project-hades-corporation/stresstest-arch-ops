# LLM Gateway configuration
# Provider: ollama | openai | anthropic | gemini | custom

USE_KEYLESS_CLI=true
DEFAULT_PROVIDER=ollama

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_FALLBACK_MODELS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_FALLBACK_MODELS=claude-3-5-haiku-latest

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash

# OpenAI-compatible custom endpoints (DeepSeek, Groq, vLLM, ...)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_FALLBACK_MODELS=

# OpenCode local server (OpenAI-compatible API, keyless - uses your local
# OpenCode CLI authentication, no user API key required)
OPENCODE_BASE_URL=http://localhost:8080/v1
OPENCODE_MODEL=
OPENCODE_FALLBACK_MODELS=

# LiteLLM Proxy server (OpenAI-compatible gateway, keyless from the end
# user's perspective - routes to providers like Gemini/Claude/Kimi/Copilot)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_FALLBACK_MODELS=
